"""
Maya AI - Advanced Personal Desktop Assistant
Configuration: Copy this to .env and fill in your API keys and paths
"""

# ========================
# API KEYS - Get from:
# Weather API: https://www.weatherapi.com/
# SerpAPI: https://serpapi.com/
# Zenserp: https://zenserp.com/
# News API: https://newsapi.org/
# ========================

WEATHER_API_KEY=your_weather_api_key_here
SERP_API_KEY=your_serp_api_key_here
ZENSERP_API_KEY=your_zenserp_api_key_here
NEWS_API_KEY=your_news_api_key_here

# ========================
# LOCAL MODEL PATHS
# ========================
# Make sure these models are installed on your system
# Install via Ollama: https://ollama.ai/

LLAMA_PATH=llama2
QWEN_PATH=qwen
BLACKBOX_PATH=blackbox

# ========================
# VOICE SETTINGS
# ========================
# Voice ID for female voice output
VOICE_ID=female_1
OWNER_NAME=Your_Name
WAKE_WORD=Hey Maya

# ========================
# SYSTEM SETTINGS
# ========================
DEBUG_MODE=False
AUTO_LEARN=True
HINGLISH_MODE=True
VOICE_MODE=False
GUI_MODE=False
OWNER_ONLY_MODE=True

# ========================
# PERFORMANCE
# ========================
MAX_RESPONSE_TIME=30
CACHE_ENABLED=True
THREADING_ENABLED=True

# ========================
# SECURITY
# ========================
ADMIN_PASSWORD=your_secure_password_here
